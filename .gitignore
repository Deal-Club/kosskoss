# Dépendances
/node_modules
/.pnp
.pnp.*

# Build Next.js
/.next/
/out/
next-env.d.ts
tsconfig.tsbuildinfo

# Client Prisma généré (recréé par `prisma generate` au postinstall)
/src/generated

# Secrets — ne JAMAIS versionner.
# Tout ce qui commence par .env est exclu, y compris les copies de sauvegarde
# (.env.local.bak et consorts) : lister les variantes une à une laissait passer
# celles qu'on n'avait pas prévues, et le dépôt est public.
.env*
# Seule exception : le modèle sans valeurs.
!.env.example

# Base SQLite de l'ancienne configuration (la prod tourne sur PostgreSQL/Neon)
*.db
*.db-journal
*.sqlite

# Dossiers de travail temporaires (scraping, captures Playwright)
/.tmp-*
/.playwright-mcp

# Maquette client : sortie régénérable de scripts/maquette (construire.mjs +
# capture.mjs), 14 Mo de HTML autoportant et de captures. Le générateur est
# versionné, son produit non — comme un dossier de build.
/livrables
/prisma-migrations-mysql.bak
/prisma-migrations-sqlite.bak

# Envois d'images en local : en production tout passe par Cloudinary
/public/uploads/*
!/public/uploads/.gitkeep

# Originaux bruts des visuels produits (source ~100 Mo, non versionnée) : les
# images du catalogue sont générées, compressées et servies depuis
# public/images/products/ via scripts/fetch-kk-images.mjs.
/assets/

# Notes de travail personnelles
/texte

# Espace de travail des agents (registres SDD, rapports de revue) — scratch
/.superpowers/

# Système
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# Variables de production préparées pour Hostinger — contient les secrets
/hostinger-env.txt

# Dossier de session Claude Code (mémoire, worktrees d'agents) — jamais versionné
/.claude/
