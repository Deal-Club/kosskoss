# Modèle des variables d'environnement de Koss Koss.
#
# En local : copier ce fichier en `.env.local` et remplir les valeurs.
# En production : saisir ces variables dans le panneau de l'hébergeur.
# `.env.local` n'est JAMAIS versionné. Aucun secret ne doit figurer ici.
#
# Générer un secret aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------------------
# Adresse publique du site — sans barre oblique finale.
# Sert aux URL canoniques, au sitemap, au flux produits et aux liens e-mail.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# Base de données PostgreSQL. Utiliser une chaîne « pooled » avec sslmode=require.
# NE JAMAIS pointer vers une base de production pendant le développement.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# ---------------------------------------------------------------------------
# Back-office : compte d'amorçage utilisé uniquement si la table AdminUser est vide.
# ADMIN_EMAIL sert aussi de boîte de la boutique (notification « nouvelle commande »).
# L'adresse doit être une boîte réellement relevable (code de connexion 2FA).
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Compte de secours masqué (rôle « superadmin ») : absent de la liste des accès
# du back-office, absent des notifications, journalisé sous « System ».
# Posé par `npx tsx --env-file=.env.local scripts/acces-admin.ts --appliquer`.
# À ne renseigner QUE le temps de lancer ce script, jamais dans le panneau de
# l'hébergeur : le compte vit ensuite en base, l'application ne lit pas ces
# deux variables. Laisser vide si l'on n'en veut pas.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Signature des sessions administrateur (32 octets hexadécimaux)
ADMIN_SESSION_SECRET=
# Signature des sessions clients (distinct du secret admin)
CUSTOMER_SESSION_SECRET=
# Chiffrement AES-256-GCM des clés d'intégration stockées en base (32 octets hex)
INTEGRATION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# E-mails transactionnels (SMTP). 465 = SSL implicite.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Koss Koss

# Destinataires de la notification « nouvelle commande » (séparés par des virgules).
ORDER_NOTIFICATION_EMAILS=

# ---------------------------------------------------------------------------
# Cloudinary : stockage des images produits.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Jeton protégeant /api/cron/campaigns (tâche planifiée d'envoi des campagnes).
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Contact flottant (facultatif).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SMARTSUPP_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Mode maintenance : OUVERT par défaut. Mettre 1 pour fermer la vitrine.
# ---------------------------------------------------------------------------
MAINTENANCE_MODE=0
