// Modèle de données de la boutique KossKoss Select.
// Base de production et de développement : PostgreSQL (Neon), via la seule
// variable DATABASE_URL — voir docs/DATABASE.md.
// Contrainte volontaire : ni enum Prisma ni liste scalaire, pour que le même
// schéma reste portable d'un moteur SQL à l'autre.
// Sous Postgres, un `String` est un `text` sans limite de longueur : aucune
// annotation n'est nécessaire sur les descriptions, les colonnes JSON ou les
// notes, contrairement à MySQL où il aurait fallu `@db.Text`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Catalogue ----

model Group {
  id         String     @id @default(cuid())
  slug       String     @unique
  label      String
  // Traduction anglaise ; vide = repli sur le français
  labelEn    String     @default("")
  position   Int        @default(0)
  categories Category[]
}

model Category {
  id             String   @id @default(cuid())
  groupId        String
  slug           String
  label          String
  description    String   @default("")
  image          String   @default("")
  guideIntro     String   @default("")
  guideClosing   String   @default("")
  // Traductions anglaises ; vides = repli sur le français
  labelEn        String   @default("")
  descriptionEn  String   @default("")
  guideIntroEn   String   @default("")
  guideClosingEn String   @default("")
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guideSections GuideSection[]
  products      Product[]

  @@unique([groupId, slug])
  @@index([groupId])
}

model GuideSection {
  id         String @id @default(cuid())
  categoryId String
  heading    String
  body       String
  headingEn  String @default("")
  bodyEn     String @default("")
  position   Int    @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Product {
  id                    String   @id @default(cuid())
  categoryId            String
  brand                 String
  name                  String
  slug                  String   @unique
  sku                   String
  // Description courte : sous le titre, dans le bloc d'achat.
  // Description longue : plus bas dans la page, dans son propre bloc.
  shortDescription      String   @default("")
  description           String   @default("")
  // Encodé en JSON : pas de liste scalaire, le schéma reste portable
  bullets               String   @default("[]")
  // Tags du Diagnostic Beauté (JSON de clés : peau_grasse, hydratation…).
  // Servent au moteur de recommandation par score de correspondance.
  tags                  String   @default("[]")
  // Traductions anglaises ; vides = repli sur le français
  nameEn                String   @default("")
  shortDescriptionEn    String   @default("")
  descriptionEn         String   @default("")
  bulletsEn             String   @default("[]")
  // Attributs exigés par Google Merchant Center pour la validation des fiches
  gtin                  String?
  mpn                   String?
  // new | refurbished | used
  condition             String   @default("new")
  googleProductCategory String   @default("")
  // Poids d'expédition en grammes, utilisé par le flux Merchant
  shippingWeightGrams   Int?
  energyEfficiencyClass String?
  image                 String?
  // Vues complémentaires, en JSON comme `bullets`. `image` demeure la vignette
  // de référence (listes, panier, flux Google) ; ces images-ci n'apparaissent
  // que dans la galerie de la fiche produit.
  images                String   @default("[]")
  priceCents            Int
  oldPriceCents         Int?
  badge                 String?
  editorialRating       Float?
  stock                 Int      @default(0)
  lowStockThreshold     Int      @default(5)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  category       Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reviews        Review[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  campaigns      CampaignProduct[]
  variants       ProductVariant[]
  favorites      CustomerFavorite[]
  routineSteps   RoutineStep[]

  @@index([categoryId])
  @@index([brand])
}

// ---- Paiement ----
//
// Deux tables exigées par le cahier des charges (docs/13 §3) et absentes
// jusqu'ici : l'état du paiement était porté par la seule commande.
//
// Ce que ça change concrètement : une commande ne dit pas COMBIEN de tentatives
// de paiement elle a connues, ni laquelle a abouti, ni ce que le prestataire a
// répondu. Sur du Mobile Money, où l'abandon en cours de paiement est la norme
// et où le client réessaie souvent, cette histoire est le premier outil du
// service client.

/**
 * Une tentative de paiement auprès du prestataire.
 *
 * Une commande peut en compter plusieurs : chaque reprise en crée une nouvelle
 * plutôt que d'écraser la précédente. Seule celle qui aboutit fait basculer la
 * commande en « payée ».
 */
model PaymentTransaction {
  id      String @id @default(cuid())
  orderId String

  /** Prestataire : « geniuspay ». Nommé pour qu'un changement reste traçable. */
  provider String
  /** Référence rendue par le prestataire (`MTX-…`), sa clé primaire chez lui. */
  reference String @unique
  /** Moyen choisi par le client : wave, orange_money, mtn_money, card… */
  method String @default("")

  /** Montant en FCFA ENTIERS, jamais en centimes. Voir docs/13 §5.1. */
  amount   Int
  currency String @default("XAF")
  /** Commission du prestataire et net versé, quand il les communique. */
  fees      Int @default(0)
  netAmount Int @default(0)

  /** pending · processing · completed · failed · cancelled · refunded */
  status String @default("pending")

  /** URL vers laquelle le client a été envoyé pour payer. */
  checkoutUrl String @default("")
  /** sandbox | live — pour ne jamais confondre un test et un encaissement. */
  environment String @default("sandbox")

  /** Dernière réponse brute du prestataire, en JSON. Sert au diagnostic. */
  rawResponse String @default("")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

/**
 * Journal des webhooks reçus.
 *
 * C'est le support de l'IDEMPOTENCE, et ce n'est pas une précaution théorique :
 * GeniusPay réessaie cinq fois en cas d'échec — immédiatement, puis à 5 min,
 * 30 min, 2 h et 6 h. Sans ce journal, un traitement lent renvoyant 500 après
 * avoir travaillé ferait encaisser la même commande plusieurs fois.
 *
 * `deliveryId` porte l'en-tête `X-Webhook-Delivery` quand il est présent, et à
 * défaut l'identifiant d'événement du corps. L'unicité est posée dessus : un
 * second passage est reconnu avant tout traitement.
 */
model WebhookEvent {
  id       String @id @default(cuid())
  provider String

  /** Identifiant de livraison, unique par nature. Clé de l'idempotence. */
  deliveryId String @unique
  /** payment.success, payment.failed, webhook.test… */
  event String
  /** Référence de transaction concernée, quand l'événement en porte une. */
  reference String @default("")

  /** Corps reçu, tel quel. On ne réécrit jamais ce qu'un tiers nous a envoyé. */
  payload String

  /** recu | traite | ignore | erreur */
  status String @default("recu")
  /** Message d'erreur si le traitement a échoué, pour la reprise manuelle. */
  error String @default("")

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([provider, event])
  @@index([reference])
}

// ---- Newsletter ----
//
// Bloc 12 de la structure fournie par le client. Un formulaire de newsletter
// existait autrefois dans le pied de page ; il avait été retiré parce qu'il
// n'envoyait rien nulle part — une adresse saisie disparaissait. Le bloc
// revient donc avec sa table : mieux vaut pas de formulaire du tout qu'un
// formulaire qui ment.
//
// `confirmed` prépare le double opt-in sans l'imposer aujourd'hui : la colonne
// existe, la logique d'envoi de confirmation viendra avec le prestataire
// d'e-mailing retenu.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("fr")
  // D'où vient l'inscription : « accueil », « pied-de-page », « commande »…
  // Sert à savoir quel emplacement recrute réellement.
  source    String   @default("accueil")
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---- Routines ----
//
// La routine est l'objet central de la marque, et il manquait.
//
// L'identité KossKoss Select l'écrit noir sur blanc — mission : « des ROUTINES
// simples, efficaces et adaptées » ; promesse : « une sélection de produits
// sûrs et adaptés pour DES ROUTINES QUI FONCTIONNENT ». Le retour client la
// redemande : « la mise en avant prioritairement des routines (prêtes ou
// issues du diagnostic peau) plutôt que des produits seuls ».
//
// Jusqu'ici une routine n'existait que le temps d'un écran, en mémoire, à la
// sortie du diagnostic : pas d'URL, pas de sauvegarde, pas de partage, et
// surtout aucune routine PRÊTE — la moitié de ce que la marque promet. On ne
// peut pas mettre en avant ce qui n'existe pas en base.
//
// Le prix n'est pas stocké : il est la somme des gestes, calculée au rendu.
// Un prix recopié se désaligne du catalogue au premier changement de tarif.
model Routine {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  nameEn        String  @default("")
  // Accroche d'une ligne : le besoin auquel la routine répond.
  claim         String  @default("")
  claimEn       String  @default("")
  // Texte de la page routine.
  description   String  @default("")
  descriptionEn String  @default("")
  // Étiquette de besoin (voir src/lib/kk/besoins.ts et Product.tags). Elle
  // relie la routine au rayon filtré correspondant : le visiteur qui veut
  // choisir lui-même y accède depuis la routine, en second recours.
  besoinTag     String  @default("")
  // Jeton de teinte — l'un des --tint-* de globals.css. C'est le mécanisme qui
  // casse la monochromie relevée par le client : chaque routine porte sa
  // couleur, sur l'accueil comme sur sa page. Fonctionnel avant d'être
  // décoratif : la teinte sert de repère.
  tint          String  @default("acne")
  image         String  @default("")
  position      Int     @default(0)
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps RoutineStep[]
}

// Un geste de la routine : un produit, son rôle, et pourquoi il est là.
model RoutineStep {
  id        String @id @default(cuid())
  routineId String
  productId String
  // Geste : « Nettoyer », « Traiter », « Protéger »…
  label     String
  labelEn   String @default("")
  // Le motif du choix, propre à CETTE routine : le même sérum ne se justifie
  // pas de la même façon contre les taches et contre la déshydratation.
  why       String @default("")
  whyEn     String @default("")
  position  Int    @default(0)

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([routineId, productId])
  @@index([routineId])
  @@index([productId])
}

// Variation d'un produit vendu par volume (bois vrac & palette). Le produit
// porte une variation par volume ; chacune a son prix. Un produit sans ligne
// ici reste un produit simple à prix unique.
model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  // Libellé du volume, recopié tel quel dans le panier et la commande.
  label         String
  labelEn       String  @default("")
  sku           String  @default("")
  priceCents    Int
  oldPriceCents Int?
  position      Int     @default(0)
  active        Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

// ---- Avis clients, avec circuit de validation ----

model Review {
  id            String    @id @default(cuid())
  productId     String
  authorName    String
  authorEmail   String?
  city          String?
  rating        Int
  title         String    @default("")
  body          String
  // pending | approved | rejected — en texte, pour rester portable
  status        String    @default("pending")
  moderatorNote String?
  moderatedAt   DateTime?
  moderatedBy   String?
  createdAt     DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
}

// ---- Moyens de paiement et intégrations ----

model PaymentMethod {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String   @default("")
  // Nom d'une icône lucide-react, par exemple "credit-card"
  icon        String   @default("credit-card")
  feeLabel    String   @default("")
  enabled     Boolean  @default(true)
  position    Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Integration {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  description  String   @default("")
  // Chiffré en AES-256-GCM, ne doit jamais sortir du serveur en clair
  secretCipher String?
  // Quatre derniers caractères, pour l'affichage masqué dans le back-office
  lastFour     String?
  enabled      Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  updatedBy    String?
}

// ---- Commandes ----
// Droit français de la vente à distance : la commande est archivée telle qu'elle
// a été validée par le client (§ 312f BGB). Les libellés produits, le prix
// unitaire et le moyen de paiement sont donc recopiés dans la commande et ne
// suivent plus les évolutions du catalogue.
// Tous les montants sont en centimes et TTC (Preisangabenverordnung § 3) :
// « taxCents » est la TVA *contenue* dans le total, jamais un supplément.

model Order {
  id          String @id @default(cuid())
  // Numéro lisible communiqué au client, par ex. « MLC-2026-000042 »
  orderNumber String @unique

  // Rattachement FACULTATIF à un compte client. La commande en tant qu'invité
  // reste possible — l'obliger à créer un compte serait contraire au principe
  // de minimisation (art. 5 § 1 c RGPD) rappelé par la DSK en mars 2022.
  customerId String?

  // Horodatage de l'anonymisation, posé quand le compte rattaché est supprimé.
  // La commande n'est jamais effacée : elle reste soumise aux délais de
  // conservation comptables (huit ans pour les justificatifs depuis le BEG IV,
  // § 147 al. 3 AO et § 257 al. 4 HGB) ; seules les coordonnées qui ne sont pas
  // exigées par la facture (§ 14 al. 4 UStG) sont retirées.
  anonymizedAt DateTime?
  // Jeton aléatoire exigé pour consulter la page de confirmation : le numéro
  // seul est séquentiel, donc devinable.
  accessToken  String
  // Langue dans laquelle la commande a été passée : de | en
  locale       String    @default("fr")

  // Coordonnées client
  email String
  phone String @default("")

  // Adresse de facturation
  billingSalutation String @default("")
  billingFirstName  String
  billingLastName   String
  billingCompany    String @default("")
  billingStreet     String
  billingPostalCode String
  billingCity       String
  billingCountry    String @default("DE")

  // Adresse de livraison — recopiée depuis la facturation si identique
  shippingSameAsBilling Boolean @default(true)
  shippingSalutation    String  @default("")
  shippingFirstName     String  @default("")
  shippingLastName      String  @default("")
  shippingCompany       String  @default("")
  shippingStreet        String  @default("")
  shippingPostalCode    String  @default("")
  shippingCity          String  @default("")
  shippingCountry       String  @default("DE")

  // Moyen de paiement, figé au moment de la commande
  paymentMethodKey   String
  paymentMethodLabel String
  paymentMethodFee   String @default("")

  // Mode de livraison choisi par le client : standard (gratuit, 3–5 jours) ou
  // express (70 €, 24–48 h). La clé sert à réafficher le mode dans la langue du
  // lecteur, le libellé garde une trace lisible même si les modes évoluent.
  // Les commandes antérieures au choix du mode reçoivent le standard, qui était
  // alors le seul existant.
  shippingMethodKey   String @default("standard")
  shippingMethodLabel String @default("Standardversand")

  // Référence du PaymentIntent Stripe, quand l'encaissement est configuré.
  // Reste vide sur les commandes réglées hors ligne (virement) et sur celles
  // passées avant l'activation du paiement.
  stripePaymentIntentId String?

  // Jeton rendu par le prestataire à l'ouverture du paiement, à représenter
  // pour authentifier ses notifications. Seul Nexi en a besoin : ses webhooks
  // ne sont pas signés, ils rejouent ce jeton, qu'on compare à celui stocké
  // ici. Vide pour tous les autres prestataires.
  gatewaySecurityToken String?

  // recue | en_traitement | expediee | livree | annulee
  // Statuts du CDC KossKoss — voir src/lib/orderStatus.ts.
  // Le défaut était « recue », hérité de mlcbois, alors que le tunnel écrivait
  // déjà « en_attente_paiement » : les deux valeurs coexistaient.
  status        String @default("en_attente_paiement")
  // en_attente | payee | remboursee | echouee
  paymentStatus String @default("en_attente")

  // Montants en centimes, TTC
  subtotalCents Int
  shippingCents Int
  taxCents      Int
  totalCents    Int

  // Code promo appliqué, recopié tel qu'il a été saisi et validé. Comme les
  // libellés produits, il est figé sur la commande : renommer ou supprimer le
  // coupon au back-office ne doit pas réécrire une commande déjà passée.
  couponCode     String @default("")
  // Remise accordée, en centimes, déjà déduite de `totalCents`.
  discountCents  Int    @default(0)
  // Taux de TVA appliqué, en points de pourcentage (10 pour le bois de chauffage domestique)
  taxRatePercent Int    @default(19)
  currency       String @default("EUR")

  customerNote String @default("")
  adminNote    String @default("")

  // Consentements horodatés : AGB et information sur le droit de rétractation
  termsAcceptedAt          DateTime?
  withdrawalAcknowledgedAt DateTime?

  // Le stock est décrémenté à la commande ; le drapeau évite un double
  // réapprovisionnement si la commande est annulée deux fois de suite.
  stockRestored Boolean @default(false)

  // Attribution marketing. Renseignés quand la commande suit un clic sur le
  // lien d'une campagne — le cookie posé par /c/<jeton> vit trente jours. Une
  // commande sans clic préalable n'est attribuée à personne, c'est ce qui rend
  // le chiffre exploitable.
  campaignId           String?
  campaignRecipientId  String?
  // Livraison offerte accordée par une campagne. Conservé pour les commandes
  // antérieures : depuis que le standard est gratuit sans minimum d'achat, la
  // mention n'accorde plus d'avantage, et elle ne couvre pas l'express.
  campaignFreeShipping Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?
  shippedAt DateTime?

  items             OrderItem[]
  events            OrderEvent[]
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  campaign          Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignRecipient CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerId])
  transactions PaymentTransaction[]
  invoice      Invoice?

  @@index([campaignId])
}

// Facture émise à l'encaissement, jamais avant.
//
// Elle porte sa PROPRE séquence, distincte du numéro de commande : la facture
// n'existant qu'après paiement, réutiliser le numéro de commande laisserait un
// trou dans la numérotation à chaque panier abandonné — ce qu'un comptable
// refuse. Voir docs/superpowers/specs/2026-08-20-lot1-…-design.md.
//
// Le montant est RECOPIÉ et non lu sur la commande : une correction ultérieure
// de la commande ne doit pas modifier ce qui a été facturé.
model Invoice {
  id         String   @id @default(cuid())
  number     String   @unique
  // Une facture par commande, jamais deux. C'est la ceinture qui accompagne la
  // sortie anticipée de updatePaymentStatus.
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issuedAt   DateTime @default(now())
  // FCFA entiers, comme partout : le nom « Cents » est hérité, il ment.
  totalCents Int
  currency   String   @default("XAF")
  createdAt  DateTime @default(now())

  @@index([issuedAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  // Le produit peut disparaître du catalogue ; la ligne de commande reste
  // lisible grâce aux libellés recopiés ci-dessous.
  productId    String?
  variantId    String?
  variantLabel String  @default("")

  brand String
  name  String
  sku   String @default("")
  slug  String @default("")
  image String @default("")
  // Chemin de la fiche produit au moment de la commande : « gruppe/kategorie/produkt »
  path  String @default("")

  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderEvent {
  id        String @id @default(cuid())
  orderId   String
  // status | payment | note | email
  kind      String @default("status")
  fromValue String @default("")
  toValue   String @default("")
  note      String @default("")

  createdAt DateTime @default(now())
  createdBy String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---- Diagnostic Beauté ----
// Questionnaire éditable depuis le back-office. Le moteur de recommandation
// (src/server/kk/diagnostic.ts) lit ces tables ; les tags produits vivent sur
// Product.tags. Les poids de tags par réponse sont encodés en JSON.

model DiagQuestion {
  id         String  @id @default(cuid())
  // Clé stable (ne change pas si le libellé change) : sert au seed et à l'ordre.
  key        String  @unique
  title      String
  titleEn    String  @default("")
  subtitle   String  @default("")
  subtitleEn String  @default("")
  position   Int     @default(0)
  active     Boolean @default(true)

  answers DiagAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiagAnswer {
  id            String  @id @default(cuid())
  questionId    String
  key           String
  label         String
  labelEn       String  @default("")
  description   String  @default("")
  descriptionEn String  @default("")
  // Nom d'icône lucide (droplet, sun, shield…), résolu côté front.
  icon          String  @default("check")
  // Poids de tags en JSON : { "peau_grasse": 3, "imperfections": 1 }
  tags          String  @default("{}")
  // Étiquette de profil affichée dans le résultat (facultative).
  chip          String  @default("")
  position      Int     @default(0)
  active        Boolean @default(true)

  question DiagQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ---- Stock ----

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  delta     Int
  // Motif du mouvement : wareneingang | korrektur | verkauf | retoure
  reason    String   @default("korrektur")
  note      String?
  createdAt DateTime @default(now())
  createdBy String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---- Comptes clients de la boutique ----
// Le compte est un confort, jamais une condition pour commander : la
// Datenschutzkonferenz (Beschluss du 24 mars 2022) considère qu'imposer un
// compte pour une commande ponctuelle viole le principe de minimisation.
// Le compte ne stocke donc que ce qui sert à re-remplir le tunnel de commande
// et à consulter l'historique.

model Customer {
  id           String @id @default(cuid())
  email        String @unique
  // Toujours haché en scrypt (src/lib/password.ts). Ne sort jamais du serveur.
  passwordHash String

  // Identité — « salutation » reste un texte libre court (m | mme | divers),
  // pas un enum Prisma, pour rester compatible SQLite et PostgreSQL.
  salutation String @default("")
  firstName  String
  lastName   String
  phone      String @default("")

  // Adresse de facturation, pré-remplie dans le tunnel de commande
  billingCompany    String @default("")
  billingStreet     String @default("")
  billingPostalCode String @default("")
  billingCity       String @default("")
  billingCountry    String @default("DE")

  // Adresse de livraison — ignorée tant que shippingSameAsBilling est vrai
  shippingSameAsBilling Boolean @default(true)
  shippingSalutation    String  @default("")
  shippingFirstName     String  @default("")
  shippingLastName      String  @default("")
  shippingCompany       String  @default("")
  shippingStreet        String  @default("")
  shippingPostalCode    String  @default("")
  shippingCity          String  @default("")
  shippingCountry       String  @default("DE")

  // Langue d'inscription : de | en
  locale String @default("fr")

  // Vérification de l'adresse : pas obligatoire pour un simple compte client,
  // le drapeau est en place pour un double opt-in ultérieur.
  emailVerified Boolean @default(false)
  active        Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders             Order[]
  passwordResets     CustomerPasswordReset[]
  campaignRecipients CampaignRecipient[]
  favorites          CustomerFavorite[]
}

// Produit mis en favori par un client connecté.
//
// Tant que le visiteur n'a pas de compte, ses favoris restent dans son
// navigateur (localStorage). À la connexion, la liste locale est versée ici et
// la base devient la seule source de vérité : le client retrouve sa sélection
// sur son téléphone comme sur son ordinateur.
//
// Aucun prix n'est recopié : seule la référence du produit est conservée, et la
// liste est relue au tarif du jour. Mémoriser un produit n'est pas le réserver.
model CustomerFavorite {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Un même produit ne figure qu'une fois par compte : c'est la base qui tient
  // l'invariant, pas l'ordre des requêtes. Deux onglets qui cliquent en même
  // temps ne peuvent donc pas créer de doublon.
  @@unique([customerId, productId])
  @@index([customerId])
}

// Réinitialisation du mot de passe : seul le SHA-256 du jeton est stocké.
// Le jeton en clair n'existe que dans le lien envoyé par e-mail — une fuite de
// la base ne permet donc pas de prendre la main sur un compte.
model CustomerPasswordReset {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

// ---- Comptes du back-office ----

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("admin")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Deuxième facteur : après un mot de passe valide, un code à six chiffres est
// envoyé par e-mail. Le code n'est jamais stocké en clair (scrypt, comme les
// mots de passe) et la ligne porte son propre compteur de tentatives.
// L'identifiant est un jeton aléatoire de 32 octets, pas un cuid : il transite
// par le navigateur et ne doit pas être devinable.
model AdminLoginChallenge {
  id          String    @id
  // Unique à dessein : un compte n'a jamais qu'un défi vivant à la fois. C'est
  // la base qui garantit l'invariant, et non plus l'ordre des requêtes — deux
  // connexions simultanées ne peuvent donc plus créer deux défis et expédier
  // deux codes.
  adminUserId String    @unique
  email       String
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  // Dernier envoi, pour le délai d'attente avant renvoi du code
  sentAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---- Fragments de code injectés dans la boutique ----
//
// Gestionnaire de balises, pixel publicitaire, balise de vérification de
// propriété : autant de fragments que le commerçant doit pouvoir poser sans
// attendre un déploiement.
//
// Le contenu est du HTML brut, inséré tel quel dans les pages de la boutique.
// Écrire ici revient à exécuter du code chez chaque visiteur : l'écriture est
// réservée à un administrateur authentifié et chaque ligne porte le nom de qui
// l'a publiée. Le back-office, lui, n'est jamais concerné — l'injection a lieu
// dans le layout de la boutique, hors duquel /admin se trouve déjà.

model CodeSnippet {
  id        String   @id @default(cuid())
  // Intitulé libre, pour s'y retrouver dans la liste : « Google Tag Manager »…
  name      String
  // head | bodyStart | bodyEnd
  placement String
  content   String
  // Catégorie de consentement : necessaire | mesure | marketing.
  //
  // Défaut volontairement RESTRICTIF. Un fragment collé dans cet écran est
  // presque toujours un gestionnaire de balises ou un pixel : le supposer
  // nécessaire au fonctionnement de la boutique reviendrait à le déclencher
  // sans consentement, ce qui est précisément l'infraction que le bandeau
  // évite. La migration reclasse donc les fragments existants en « marketing »,
  // et ils cessent de partir tant que le visiteur n'a pas accepté.
  category  String   @default("marketing")
  // Un fragment naît désactivé : on le colle, on le relit, puis on l'allume.
  enabled   Boolean  @default(false)
  // Ordre d'insertion à emplacement égal. Il compte : un mode consentement doit
  // s'exécuter avant les balises qu'il gouverne.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String

  // La boutique ne lit que les fragments actifs, emplacement par emplacement.
  @@index([enabled, placement, position])
}

// ---- Pages légales et informatives ----
//
// Les onze pages de pied de page (Impressum, AGB, Datenschutz, FAQ…) sont
// écrites dans `src/content/legal/fr.ts` et `en.ts`. Ces fichiers restent la
// version d'origine, versionnée avec le code ; cette table ne porte QUE les
// pages réécrites depuis l'administration.
//
// Règle de lecture, appliquée dans `src/server/legalPages.ts` : une ligne ici
// l'emporte sur le fichier, son absence fait retomber sur le fichier. Aucune
// donnée à migrer le jour de la mise en ligne, et « réinitialiser une page »
// revient à supprimer sa ligne.

model LegalContent {
  // Identifiant d'URL de la page : "impressum", "agb", "faq"…
  slug   String
  // "fr" ou "en" : chaque langue se réécrit indépendamment.
  locale String

  // Page complète sérialisée en JSON (titre, chapeau, sections, date de
  // révision). Le JSON évite onze tables filles pour une structure qui n'est
  // jamais interrogée autrement que « toute la page d'un coup ».
  data String

  // E-mail de l'administrateur qui a publié : sur des pages juridiques,
  // savoir qui a changé quoi n'est pas un luxe.
  updatedBy String
  updatedAt DateTime @updatedAt

  @@id([slug, locale])
}

// ---- Campagnes marketing ----
//
// Une campagne fait deux choses à la fois : elle envoie un message et elle
// applique une remise sur le site. Les deux sont volontairement liés par la
// même période de validité, pour qu'un client qui clique sur le lien du
// message trouve exactement le prix annoncé.
//
// Le prix des produits n'est jamais réécrit. La remise est calculée à
// l'affichage à partir des dates ci-dessous : passé `endsAt`, le catalogue
// reprend son prix de base sans qu'aucune tâche n'ait à intervenir.

model Campaign {
  id   String @id @default(cuid())
  // Identifiant court porté par tous les liens de la campagne, par ex.
  // « CMP-7K2QX9 ». Il relie une commande à la campagne qui l'a provoquée et
  // reste lisible dans les exports.
  code String @unique
  name String

  // promotion | flash | nouveaute | offre_speciale
  type   String
  // brouillon | en_cours | envoyee | pausee | annulee
  status String @default("brouillon")

  // Contenu du message, pré-rempli depuis le modèle du type puis modifiable.
  // Les variantes anglaises servent aux clients dont la langue est « en » ;
  // vides, elles retombent sur le français comme partout ailleurs.
  subject    String @default("")
  headline   String @default("")
  bodyText   String @default("")
  ctaLabel   String @default("")
  subjectEn  String @default("")
  headlineEn String @default("")
  bodyTextEn String @default("")
  ctaLabelEn String @default("")

  // percent | amount | free_shipping | none
  discountKind  String @default("percent")
  // Pourcentage entier (20 = -20 %) ou montant en centimes, selon discountKind.
  // Vaut 0 pour free_shipping et none.
  discountValue Int    @default(0)

  // Période d'application de la remise sur le site.
  startsAt DateTime
  endsAt   DateTime

  // Page d'atterrissage quand la campagne porte plusieurs produits :
  // /aktion/<landingSlug>. Vide = lien direct vers la fiche produit.
  landingSlug String @default("")

  // Cadence d'envoi. Le nombre de messages par lot et la pause qui suit sont
  // tirés au hasard entre ces bornes : un rythme régulier est le premier
  // signal qui fait classer un expéditeur comme automate.
  batchMin    Int @default(3)
  batchMax    Int @default(10)
  delayMinSec Int @default(180)
  delayMaxSec Int @default(420)

  // Heure du prochain lot. Null tant que la campagne n'est pas lancée.
  nextBatchAt   DateTime?
  // Verrou anti-concurrence, posé le temps d'un lot : sans lui, deux passages
  // simultanés du répartiteur serviraient deux fois les mêmes destinataires.
  dispatchingAt DateTime?

  startedAt   DateTime?
  completedAt DateTime?
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products   CampaignProduct[]
  recipients CampaignRecipient[]
  events     CampaignEvent[]
  orders     Order[]

  @@index([status])
  @@index([nextBatchAt])
  @@index([startsAt, endsAt])
}

model CampaignProduct {
  id             String @id @default(cuid())
  campaignId     String
  productId      String
  // Prix de référence figé quand le produit rejoint la campagne. C'est lui qui
  // s'affiche barré, même si le catalogue bouge entre-temps : le client doit
  // retrouver la remise annoncée dans le message.
  basePriceCents Int

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([productId])
}

// Un destinataire est à la fois une ligne de la file d'attente et le support
// de tout le suivi. Les deux ne sont pas séparés à dessein : un envoi et sa
// mesure portent sur la même personne, les dissocier n'apporterait qu'une
// jointure de plus.
model CampaignRecipient {
  id         String  @id @default(cuid())
  campaignId String
  // Rattachement facultatif : un acheteur invité n'a pas de compte.
  customerId String?

  email     String
  firstName String @default("")
  lastName  String @default("")
  // de | en — langue dans laquelle le message est composé
  locale    String @default("fr")

  // Jeton aléatoire de 32 octets porté par les liens de suivi et de
  // désinscription. Ni cuid ni dérivé de l'adresse : il circule en clair dans
  // le message et ne doit pas être devinable, sinon n'importe qui pourrait
  // désinscrire un client ou fausser les statistiques.
  token String @unique

  // en_attente | envoye | echec | ignore
  status String @default("en_attente")
  // Motif du refus renvoyé par le fournisseur, tronqué. Réservé au back-office.
  error  String @default("")

  sentAt         DateTime?
  openedAt       DateTime?
  firstClickedAt DateTime?
  clickCount     Int       @default(0)
  unsubscribedAt DateTime?

  // Somme TTC des commandes attribuées, recopiée ici pour que la liste des
  // destinataires n'ait pas à agréger les commandes à chaque affichage.
  attributedCents Int @default(0)

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  events   CampaignEvent[]
  orders   Order[]

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([customerId])
}

// Liste de blocage globale. Une désinscription vaut pour toutes les campagnes
// à venir, pas seulement pour celle d'où le client est parti — l'inverse
// reviendrait à ignorer sa demande dès le message suivant.
model EmailSuppression {
  // Toujours normalisée en minuscules avant écriture.
  email      String   @id
  // desinscription | rejet | plainte
  reason     String   @default("desinscription")
  // Campagne d'origine, quand elle est connue.
  campaignId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Journal horodaté. Les dates portées par CampaignRecipient donnent l'état
// courant ; ce journal donne la chronologie, seule façon de tracer une courbe
// de clics dans le temps.
model CampaignEvent {
  id          String  @id @default(cuid())
  campaignId  String
  recipientId String?

  // envoi | ouverture | clic | commande | desinscription | echec
  kind String
  // Détail libre : montant de la commande, motif d'échec…
  note String @default("")

  createdAt DateTime @default(now())

  campaign  Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([campaignId, kind])
  @@index([campaignId, createdAt])
}

// ---- Bandeau d'annonce ----

// Message défilant en haut de la boutique, administrable.
//
// Plusieurs lignes actives défilent à la suite : c'est le seul endroit du site
// où l'on peut annoncer une livraison offerte, un délai exceptionnel ou une
// opération en cours sans toucher au code. Les réglages d'apparence (couleurs,
// vitesse, activation) vivent dans `Setting` sous la clé « announcement.config »
// — ils sont uniques, une table de configuration à une seule ligne n'apporterait
// rien.
model Announcement {
  id        String   @id @default(cuid())
  message   String
  // Nom d'une icône lucide-react ; vide = aucune icône devant le message.
  icon      String   @default("sparkles")
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

// ---- Codes promo ----

// Code de réduction saisi par le client au moment de payer.
//
// La remise n'est jamais calculée par le navigateur : le tunnel affiche une
// estimation, mais `createKossOrder` revalide le code et recalcule le montant
// à partir de cette table avant d'enregistrer la commande. Un code désactivé,
// expiré ou épuisé entre l'affichage et la validation est donc refusé au
// dernier moment, et le client paie le prix plein.
model Coupon {
  id   String @id @default(cuid())
  // Toujours stocké en majuscules sans espaces : la saisie du client est
  // normalisée avant comparaison, « bienvenue10 » et « BIENVENUE10 » sont le
  // même code.
  code String @unique

  // « pourcentage » : `value` est un taux de 1 à 100.
  // « montant »     : `value` est une somme en FCFA entiers.
  kind  String @default("pourcentage")
  value Int

  /// Sous-total minimal exigé pour que le code s'applique, en FCFA. 0 = aucun.
  minSubtotalCents Int @default(0)
  /// Plafond de la remise pour un code en pourcentage, en FCFA. 0 = aucun.
  maxDiscountCents Int @default(0)

  // Fenêtre de validité. Bornes absentes = pas de limite de ce côté.
  startsAt DateTime?
  endsAt   DateTime?

  /// Nombre total d'utilisations autorisées, toutes commandes confondues. 0 = illimité.
  maxUses   Int @default(0)
  /// Compteur incrémenté à chaque commande validée avec ce code.
  usedCount Int @default(0)

  active      Boolean  @default(true)
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

// ---- Le Journal : espace éditorial ----
//
// Un article n'est pas un produit : il vit longtemps, son adresse est partagée,
// et il se réécrit. Trois choix de structure en découlent, et ils expliquent
// tout le reste de ce bloc.
//
//  1. Le CONTENU est un tableau de blocs sérialisé en JSON (`blocks`), pas du
//     HTML et pas une table fille par bloc. Pas de HTML parce que le rendu
//     passe par des composants React et les marques restreintes de
//     `src/lib/richText.ts` : aucune balise collée dans le back-office ne peut
//     s'exécuter chez un visiteur. Pas de table fille parce qu'un article n'est
//     jamais interrogé autrement que « tout le contenu d'un coup » — c'est le
//     même raisonnement que pour `LegalContent`.
//
//  2. La CORBEILLE est `deletedAt`, pas un statut. Un article jeté conserve
//     ainsi le statut qu'il avait, et le restaurer le remet exactement où il
//     était. Prisma n'a pas de suppression douce native : le filtre est appliqué
//     explicitement dans `src/server/journal/`, en un seul endroit.
//
//  3. Les TRADUCTIONS suivent la convention du catalogue : colonnes `*En`
//     facultatives, vide = repli sur le français. Aucun champ vide sur la
//     boutique anglaise.

model Article {
  id   String @id @default(cuid())
  slug String @unique

  // draft | scheduled | published | archived — voir src/types/journal.ts.
  // Pas d'enum Prisma : le schéma s'interdit les enums pour rester portable.
  status String @default("draft")

  title     String
  titleEn   String @default("")
  excerpt   String @default("")
  excerptEn String @default("")

  // Tableau de blocs sérialisé. « [] » et non « » : la lecture n'a jamais à
  // distinguer « pas encore écrit » de « vidé ».
  blocks   String @default("[]")
  blocksEn String @default("[]")

  coverImage String @default("")
  coverAlt   String @default("")
  coverAltEn String @default("")

  categoryId String?
  authorId   String?

  // Un article mis en avant remonte sur la page du Journal et peut être repris
  // ailleurs. Le nombre affiché est plafonné à la lecture, pas ici : limiter en
  // base empêcherait de préparer la mise en avant suivante.
  featured Boolean @default(false)

  // Dérivés du contenu, recalculés à chaque écriture. Stockés parce que les
  // listes les affichent : les recalculer pour vingt-cinq articles à chaque
  // rendu de page reviendrait à relire tout le contenu pour un « 6 min ».
  readingMinutes Int @default(1)

  // Compteur dénormalisé. Le détail par jour vit dans ArticleViewDay ; « les
  // plus lus » lit cette colonne et ne fait jamais de COUNT.
  viewCount Int @default(0)

  publishedAt DateTime?
  scheduledAt DateTime?
  deletedAt   DateTime?

  // --- SEO ---
  // Tous facultatifs : les replis sont calculés par src/server/journal/seo.ts.
  metaTitle          String  @default("")
  metaTitleEn        String  @default("")
  metaDescription    String  @default("")
  metaDescriptionEn  String  @default("")
  focusKeyword       String  @default("")
  canonicalUrl       String  @default("")
  robotsNoindex      Boolean @default(false)
  ogTitle            String  @default("")
  ogDescription      String  @default("")
  ogImage            String  @default("")
  twitterTitle       String  @default("")
  twitterDescription String  @default("")
  twitterImage       String  @default("")

  // Architecture préparée, fonctionnalité fermée — voir ArticleComment.
  commentsEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // E-mail de l'administrateur qui a publié, comme LegalContent et CodeSnippet.
  updatedBy String   @default("")

  category  ArticleCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author    ArticleAuthor?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags      ArticleTagLink[]
  revisions ArticleRevision[]
  comments  ArticleComment[]
  views     ArticleViewDay[]
  redirects ArticleRedirect[]

  // La liste publique lit toujours « publié, daté, non supprimé, du plus
  // récent » : c'est cet index-là qui la sert.
  @@index([status, publishedAt])
  @@index([deletedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([featured, publishedAt])
}

// Catégorie éditoriale. Distincte des catégories du catalogue : « Conseils
// d'experte » n'est pas un rayon, et mélanger les deux casserait autant la
// navigation de la boutique que celle du Journal.
//
// La hiérarchie s'arrête volontairement à un niveau : au-delà, le fil d'Ariane
// devient illisible et le maillage interne se dilue sur des pages presque vides.
model ArticleCategory {
  id            String @id @default(cuid())
  slug          String @unique
  label         String
  labelEn       String @default("")
  description   String @default("")
  descriptionEn String @default("")
  image         String @default("")

  metaTitle       String @default("")
  metaDescription String @default("")

  parentId String?
  position Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   ArticleCategory?  @relation("ArticleCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ArticleCategory[] @relation("ArticleCategoryTree")
  articles Article[]

  @@index([parentId])
  @@index([active, position])
}

model ArticleTag {
  id      String @id @default(cuid())
  slug    String @unique
  label   String
  labelEn String @default("")

  createdAt DateTime @default(now())

  articles ArticleTagLink[]
}

// Table de liaison explicite, comme CampaignProduct et CustomerFavorite : le
// dépôt n'utilise pas les relations implicites de Prisma.
model ArticleTagLink {
  articleId String
  tagId     String

  article Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

// Identité publique d'un auteur.
//
// Volontairement séparée d'AdminUser : un compte du back-office est un accès
// technique protégé par un second facteur, sans photo ni biographie, et qu'on
// désactive le jour où quelqu'un s'en va. Un auteur est une signature qui reste
// sur les articles publiés. `adminUserId` relie les deux quand c'est la même
// personne, sans les confondre.
model ArticleAuthor {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  role   String @default("")
  roleEn String @default("")
  bio    String @default("")
  bioEn  String @default("")
  avatar String @default("")

  // JSON : { "instagram": "...", "linkedin": "..." }. Pas de liste scalaire.
  socials String @default("{}")

  adminUserId String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]
}

// Ancienne adresse d'un article renommé après publication.
//
// Sans cette table, corriger le titre d'un article référencé casserait son URL
// en silence. La page article lit ici avant de rendre un 404 et répond par une
// redirection permanente.
model ArticleRedirect {
  id        String   @id @default(cuid())
  oldSlug   String   @unique
  articleId String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

// Instantané d'un article, écrit à chaque enregistrement manuel et à chaque
// publication.
//
// L'écriture des versions démarre en v1 même si la restauration n'est pas
// exposée : un historique qu'on branche le jour où on en a besoin démarre vide,
// c'est-à-dire trop tard.
model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String
  // Article complet sérialisé, même parti pris que LegalContent.data.
  snapshot  String
  updatedBy String   @default("")
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

// Commentaires : la table existe, la fonctionnalité n'est pas ouverte.
//
// Aucune route publique n'écrit ici et aucun formulaire ne s'affiche. Le circuit
// de validation reprend celui des avis produits (pending/approved/rejected) pour
// que l'ouvrir plus tard ne demande pas d'inventer un second vocabulaire.
model ArticleComment {
  id          String    @id @default(cuid())
  articleId   String
  authorName  String
  authorEmail String
  body        String
  // pending | approved | rejected
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  moderatedAt DateTime?
  moderatedBy String    @default("")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, status])
}

// Vues agrégées par jour.
//
// Une ligne par article et par jour, jamais une ligne par visite : le détail
// n'apporte rien et une table de visites grossit sans fin. Le total vit dans
// Article.viewCount, incrémenté dans la même transaction — « les plus lus » se
// lit alors sans agrégat.
model ArticleViewDay {
  articleId String
  // Jour à minuit UTC. Sert de clé, donc jamais d'horodatage complet.
  day       DateTime
  count     Int      @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day])
  @@index([day])
}
